# Environment variables. Each change that reads a variable adds it here (no secrets).
PORT=3000
# 0.0.0.0 is required inside containers; use 127.0.0.1 for local-only access.
HOST=0.0.0.0
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Required. For `npm run dev` you need your own Postgres (compose does not publish 5432).
DATABASE_URL=postgresql://smartlog:smartlog@localhost:5432/smartlog
# Insert the fixed dev services on boot (idempotent). Accepts true/false/1/0.
SEED_ON_START=true
# LLM provider: mock (default, deterministic, no network) or gemini.
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Per-attempt timeout in milliseconds (positive integer).
LLM_TIMEOUT_MS=30000
# Retries after the first attempt, 0..10 (0 = a single attempt).
LLM_MAX_RETRIES=3
# Used only by docker-compose.yml (dev defaults, not real secrets).
POSTGRES_USER=smartlog
POSTGRES_PASSWORD=smartlog
POSTGRES_DB=smartlog
