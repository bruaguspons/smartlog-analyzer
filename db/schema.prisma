generator client {
  provider            = "prisma-client"
  output              = "../src/shared/db/generated"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  apiKey      String  @unique @map("api_key")
  isActive    Boolean @default(true) @map("is_active")
  logs        Log[]

  @@map("services")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL

  @@map("log_level")
}

model Log {
  id        String   @id @db.Uuid
  serviceId Int      @map("service_id")
  level     LogLevel
  timestamp DateTime @db.Timestamptz(3)
  message   String
  traceId   String?  @map("trace_id")
  metadata  Json?
  service   Service  @relation(fields: [serviceId], references: [id])

  @@index([timestamp(sort: Desc), id(sort: Desc)], map: "logs_timestamp_id_idx")
  @@index([serviceId, timestamp(sort: Desc), id(sort: Desc)], map: "logs_service_id_timestamp_id_idx")
  @@index([level, timestamp(sort: Desc)], map: "logs_level_timestamp_idx")
  @@index([traceId], map: "logs_trace_id_idx")
  @@map("logs")
}
